# ------------------------------------------------------------
# Asha Pets — environment configuration
# Copy to `.env` (or set these in your hosting dashboard).
# Everything here is optional: the site works with none of it set.
# ------------------------------------------------------------

# Canonical site origin, no trailing slash.
# Used for canonical tags, sitemap.xml, robots.txt and Open Graph.
VITE_SITE_URL=https://ashapets.in

# --- Live Google reviews -------------------------------------
# RECOMMENDED: point this at the deployed serverless proxy in /api.
# The key stays on the server and responses are CDN-cached.
VITE_REVIEWS_ENDPOINT=/api/google-reviews

# Server-side variables consumed by /api/google-reviews.js.
# Set these in your host's dashboard, NOT in a committed .env.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=

# --- Optional direct browser fallback ------------------------
# Only use these if you are not deploying the proxy. The key is
# visible in the bundle, so restrict it by HTTP referrer AND to
# the Places API (New) in Google Cloud Console.
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_PLACE_ID=
